---
interface Props {
  title?: string;
  current?: 'home' | 'about' | 'products' | 'products-sub' | 'industries' | 'contact' | 'blog';
}
const { title = 'Swastik Industries', current } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
    <meta name="color-scheme" content="light" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap" />
    <link rel="stylesheet" href="/style.css" />
  </head>
  <body>
<header class="site-head" id="top"><div class="pill"><a class="logo" href="/" aria-label="Swastik Industries home"><img src="/assets/logo-navy.png" alt="Swastik Industries, established 2005" width="140" height="58"></a><nav class="nav" id="nav" aria-label="Main"><a href="/" aria-current={current === 'home' || (current === 'products-sub' && 'home' === 'products') ? 'page' : undefined}>Home</a><a href="/about" aria-current={current === 'about' ? 'page' : undefined}>About us</a><div class="has-menu"><a href="/products" aria-haspopup="true" aria-current={current === 'products' || (current === 'products-sub' && 'products' === 'products') ? 'page' : undefined}>Products <svg class="chev" width="10" height="6" viewBox="0 0 10 6" aria-hidden="true"><path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.6"/></svg></a><div class="menu" role="menu"><div class="menu-in"><a role="menuitem" href="/cable-trays"><img src="/assets/products/perforated-tray.jpg" alt="" width="64" height="44" loading="lazy"><span><b>Cable tray</b><small>Perforated and ladder type</small></span></a><a role="menuitem" href="/raceway"><img src="/assets/products/raceway.jpg" alt="" width="64" height="44" loading="lazy"><span><b>Raceway</b><small>Channels, junction boxes, arms</small></span></a><a role="menuitem" href="/steel-structures"><img src="/assets/products/solar-structure.jpg" alt="" width="64" height="44" loading="lazy"><span><b>Structures</b><small>Substation, solar and towers</small></span></a><a role="menuitem" href="/earthing-hardware"><img src="/assets/products/earthing.jpg" alt="" width="64" height="44" loading="lazy"><span><b>Earthing</b><small>IS 4759, IS 3043, IS 1239</small></span></a><a role="menuitem" href="/gratings"><img src="/assets/products/grating.jpg" alt="" width="64" height="44" loading="lazy"><span><b>Grating</b><small>Up to 2 m x 2 m</small></span></a><a class="all" href="/products">View full range</a></div></div></div><a href="/industries" aria-current={current === 'industries' || (current === 'products-sub' && 'industries' === 'products') ? 'page' : undefined}>Industries &amp; Applications</a><a href="/blog" aria-current={current === 'blog' || (current === 'products-sub' && 'blog' === 'products') ? 'page' : undefined}>Blog</a><a class="nav-cta" href="/contact" aria-current={current === 'contact' || (current === 'products-sub' && 'contact' === 'products') ? 'page' : undefined}>Contact us</a><span class="ind" aria-hidden="true"></span></nav><button class="burger" type="button" aria-label="Menu" aria-expanded="false" aria-controls="nav"><span></span><span></span><span></span></button></div><div class="progress" aria-hidden="true"></div></header>
    <slot />
<footer class="site-foot"><div class="wrap"><div class="foot-grid">
<div><img src="/assets/logo-white.png" alt="Swastik Industries" width="122" height="50"><p style="margin-top:1rem;font-size:.95rem">Cable trays, earthing material, structures, gratings and hot dip galvanising. Manufacturing since 2005.</p></div>
<div><h4>Products</h4><ul><li><a href="/cable-trays">Cable tray</a></li><li><a href="/raceway">Raceway</a></li><li><a href="/steel-structures">Structures</a></li><li><a href="/earthing-hardware">Earthing</a></li><li><a href="/gratings">Grating</a></li></ul></div>
<div><h4>Company</h4><ul><li><a href="/about">About us</a></li><li><a href="/industries">Industries &amp; Applications</a></li><li><a href="/blog">Blog</a></li><li><a href="/assets/catalogue.pdf" target="_blank" rel="noopener">Catalogue (PDF)</a></li><li><a href="/contact">Contact us</a></li></ul></div>
<div><h4>Contact</h4><ul><li>+91 98990 49419</li><li>+91 98110 15120</li><li>info@swastikindustries.co.in</li><li>swastikindustries@live.in</li></ul></div>
<div><h4>Address</h4><p style="font-size:.875rem">Office: 14/20, Prakash Vihar, Shahbad Daulatpur, Delhi 110042<br>Mailing: A-1, East of Kailash, Delhi 110065</p></div>
</div><div class="legal"><span>&copy; 2026 Swastik Industries. Est. 2005.</span><span>swastikindustries.co.in</span></div></div></footer>
    <script is:inline src="/site.js"></script>
  </body>
</html>
