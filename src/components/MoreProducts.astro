---
interface Props { current: string }
const { current } = Astro.props;
const products = [
  { id: 'cable-trays', title: 'Cable Trays', img: 'perforated-tray' },
  { id: 'raceway', title: 'Raceway and Channels', img: 'raceway' },
  { id: 'earthing-hardware', title: 'Earthing Material', img: 'earthing' },
  { id: 'steel-structures', title: 'Steel Structures', img: 'solar-structure' },
  { id: 'gratings', title: 'Gratings and Stair Treads', img: 'grating' },
];
const others = products.filter((p) => p.id !== current);
---
<section class="more-products"><div class="wrap">
  <div class="sec-head"><div class="eyebrow">Our Range</div><h2 class="h-xl">Other Products</h2></div>
  <div class="mini-grid">
    {others.map((p) => (
      <a class="mini-card" href={`/${p.id}`}>
        <div class="mini-ph"><img src={`/assets/products/${p.img}.webp`} alt={p.title} loading="lazy" /></div>
        <h3>{p.title}</h3>
      </a>
    ))}
  </div>
</div></section>
