---
import Layout from '../layouts/Layout.astro';
import MoreProducts from '../components/MoreProducts.astro';
---
<Layout title="Steel Structures - Swastik Industries" current="products-sub">
<main><div class="page-hero"><img class="bg" src="/assets/products/solar-structure.webp" alt=""><div class="wrap"><div class="crumbs"><a href="/">Home</a> / <a href="/products">Products</a> / Steel Structures</div><h1>Steel Structures and Towers</h1><p>In-house fabrication, hot dip galvanising and a testing facility, customised to your drawing.</p></div></div>
<section><div class="wrap"><div class="split"><div class="tx"><div class="eyebrow">Power and Solar</div><h2>Structures for Every Voltage Class</h2>
<p class="lede">Steel structure solutions are available for substations, power transmission lines, solar plants and pipeline supports, with their accessories.</p>
<div class="tablewrap" style="width:100%"><table class="sched"><thead><tr><th>Application</th><th>Class</th></tr></thead><tbody><tr><td>Substations</td><td class="v">11 kV, 33 kV, 66 kV, 120 kV</td></tr><tr><td>Power Transmission Lines</td><td class="v">As per drawing</td></tr><tr><td>Solar Steel Structures</td><td class="v">Ground and rooftop</td></tr><tr><td>Pipeline Supports</td><td class="v">With accessories</td></tr></tbody></table></div></div>
<div><img src="/assets/f36.webp" alt="Steel portal frame with base plates" loading="lazy"></div></div></div></section>
<section class="alt"><div class="wrap"><div class="split flip"><div class="tx"><div class="eyebrow">Towers and Walkways</div><h2>Electrical and Telecom Towers</h2><p class="lede">Lattice towers, solar structures and walkways are fabricated and galvanised in the same works as our structures.</p></div>
<div><img src="/assets/f48.webp" alt="Technician climbing a galvanised lattice tower" loading="lazy"></div></div></div></section>
<section><div class="wrap"><div class="steps"><div class="step"><span class="n">IN-HOUSE</span><h3>Fabrication</h3></div><div class="step"><span class="n">IN-HOUSE</span><h3>Hot Dip Galvanising</h3></div><div class="step"><span class="n">IN-HOUSE</span><h3>Testing Facility</h3></div></div></div></section><MoreProducts current="steel-structures" />
<section class="cta-band"><div class="wrap"><h2>Share Your Requirements with Us</h2><a class="btn" href="/contact">Request a Quote</a></div></section></main>
</Layout>
