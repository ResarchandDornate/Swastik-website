---
import Layout from '../layouts/Layout.astro';
import MoreProducts from '../components/MoreProducts.astro';
---
<Layout title="Earthing Material - Swastik Industries" current="products-sub">
<main><div class="page-hero"><img class="bg" src="/assets/products/earthing.webp" alt=""><div class="wrap"><div class="crumbs"><a href="/">Home</a> / <a href="/products">Products</a> / Earthing and hardware</div><h1>Earthing material and hardware</h1><p>Galvanised and copper earthing material to Indian standards, with the fixings that go with it.</p></div></div>
<section><div class="wrap"><div class="sec-head"><div class="eyebrow">Earthing material</div><h2>Earthing material</h2></div><div class="tablewrap"><table class="sched"><thead><tr><th>Item</th><th>Standard</th></tr></thead><tbody>
<tr><td>GI plate</td><td class="v">IS 4759</td></tr><tr><td>GI wires</td><td class="v">IS 4759</td></tr><tr><td>GI strips</td><td class="v">IS 4759</td></tr>
<tr><td>GI earth electrode</td><td class="v">IS 3043</td></tr><tr><td>GI pipe</td><td class="v">IS 1239</td></tr><tr><td>Copper earthing</td><td class="v">As per client specification</td></tr></tbody></table></div></div></section>
<section class="alt"><div class="wrap"><div class="sec-head"><div class="eyebrow">General hardware</div><h2>Fixings and clamps</h2></div>
