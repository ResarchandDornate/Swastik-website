---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Contact - Swastik Industries" current="contact">
<main><div class="page-hero"><img class="bg" src="/assets/f57.webp" alt=""><div class="wrap"><div class="crumbs"><a href="/">Home</a> / Contact</div><h1>Contact Us</h1><p>Send the product, size and quantity. We will reply with a quotation.</p></div></div>
<section><div class="wrap contact-grid"><div class="info">
<div><h3>Phone</h3><p>+91 98990 49419<br>+91 70111 58029</p></div>
<div><h3>Email</h3><p>info@swastikindustries.co.in<br>swastikindustries@live.in</p></div></div>
<form id="enq"><h3>Enquiry</h3><div class="row2"><label>Name<input id="f-name" required></label><label>Company<input id="f-co"></label></div>
<div class="row2"><label>Phone<input id="f-ph" type="tel"></label><label>Email<input id="f-em" type="email"></label></div>
<label>Product<select id="f-prod"><option>Perforated Cable Tray</option><option>Ladder Cable Tray</option><option>Raceway</option><option>Earthing Material</option><option>Steel Structures</option><option>Towers</option><option>Gratings</option><option>Hardware</option></select></label>
<label>Quantity and Specification<textarea id="f-msg" placeholder="Size, thickness, finish, quantity, delivery location"></textarea></label>
<button class="btn" type="submit">Prepare Enquiry</button>
<div class="out" id="out" role="status"></div>
<p class="note">This page cannot send mail by itself. Prepare the enquiry, copy it and email it to info@swastikindustries.co.in.</p></form></div></section></main>
</Layout>
