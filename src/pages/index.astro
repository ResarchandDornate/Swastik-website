---
import Layout from '../layouts/Layout.astro';
const industries = [
  { img: 'infrastructure', title: 'Infrastructural|Projects', text: 'Galvanised lattice towers, structural steel and walkways for infrastructure projects.' },
  { img: 'power-transmission', title: 'Power Transmission|Projects', text: 'Structures and supports for 11, 33, 66 and 120 kV substations and power lines.' },
  { img: 'renewable-bess', title: 'Renewable Energy|& BESS', text: 'Module mounting structures, walkways, cable trays and earthing for solar plants.' },
  { img: 'transport', title: 'Transport|Infrastructure', text: 'Steel work and cable support systems for metro and rail corridors.' },
  { img: 'industrial', title: 'Industrial &|Manufacturing Facilities', text: 'Cable trays, raceway, gratings, stair treads and pipeline supports for industrial plants.' },
];
---
<Layout title="Swastik Industries" current="home">
<main>
<div class="hero"><img class="poster" src="/assets/hero.webp" alt="" fetchpriority="high">
<div class="wrap hero-in"><h1>We Are Committed to Excellence in Everything</h1>
<div class="hero-actions"><a class="btn" href="/products">Explore Products</a><a class="btn ghost" href="#film">Watch the Company Film</a></div></div>
</div>



<section class="intro-band"><div class="wrap"><div class="intro-in"><h2 class="intro-h">Structural Steel and Electrical Infrastructure Solutions</h2>
<p class="intro-text">Swastik Industries provides <b>structural steel and electrical infrastructural solutions</b> to India's ever-growing infrastructure. We pride ourselves on celebrating over 20 years of experience working across multiple industries, providing in-house fabrication and tailor-made solutions across a wide range of project applications including structural systems, earthing and lightning protection system solutions, and cable tray solutions alongside raceways, walkways, gratings and related products.</p></div></div></section>
<section class="themed"><div class="wrap"><div class="sec-head"><div class="eyebrow">Product Range</div><h2>Designing Products for a New Era</h2><p class="lede">Every product is customisable to the client's drawing and specification.</p></div>
<div class="grid">
<a class="card" href="/cable-trays"><div class="ph"><img src="/assets/products/perforated-tray.webp" alt="Perforated cable tray bend" loading="lazy"></div><div class="tx"><h3>Cable Trays</h3><span class="more">View Range</span></div></a><a class="card" href="/raceway"><div class="ph"><img src="/assets/products/raceway.webp" alt="Raceway bracket detail" loading="lazy"></div><div class="tx"><h3>Raceway and Channels</h3><span class="more">View Range</span></div></a><a class="card" href="/earthing-hardware"><div class="ph"><img src="/assets/products/earthing.webp" alt="Earthing strips and rods" loading="lazy"></div><div class="tx"><h3>Earthing Material</h3><span class="more">View Range</span></div></a><a class="card" href="/steel-structures"><div class="ph"><img src="/assets/products/solar-structure.webp" alt="Steel portal frame structure" loading="lazy"></div><div class="tx"><h3>Steel Structures</h3><span class="more">View Range</span></div></a><a class="card" href="/gratings"><div class="ph"><img src="/assets/products/grating.webp" alt="Steel bar grating panel" loading="lazy"></div><div class="tx"><h3>Gratings and Stair Treads</h3><span class="more">View Range</span></div></a></div></div></section>



<section class="film" id="film"><div class="wrap film-grid"><div style="display:grid;gap:1rem"><div class="eyebrow">Company Film</div><h2>Building the Infrastructure for Today and Tomorrow</h2><p>A 98 second look at the products we make and the projects they go into, from cable trays to telecom towers.</p></div>
<video controls muted loop playsinline preload="metadata" poster="/assets/f6.webp" data-autoplay><source src="/assets/film.webm" type="video/webm"><source src="/assets/film.mp4" type="video/mp4">Your browser cannot play this video.</video></div></section>

<section class="stack-sec"><div class="wrap"><div class="sec-head"><div class="eyebrow">Where Our Products Go</div><h2 class="h-xl">Industries We Supply</h2></div></div>
<div class="wrap"><div class="stack">
{industries.map((it) => (
  <article class="stack-card"><div class="stack-tx"><h3>{it.title.split('|').map((part, i) => (<Fragment>{i > 0 && <br />}{part}</Fragment>))}</h3><p>{it.text}</p></div><div class="stack-img"><img src={`/assets/industries/${it.img}.svg`} alt={it.title.replace('|', ' ')} loading="lazy" /></div></article>
))}
</div></div>
</section>


<section class="cta-band"><div class="wrap"><h2>Share Your Requirements with Us</h2><a class="btn" href="/contact">Request a Quote</a></div></section></main>
</Layout>
