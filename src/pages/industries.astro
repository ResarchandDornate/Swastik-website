---
import Layout from '../layouts/Layout.astro';
const rows = [
  { img: 'infrastructure', title: 'Infrastructural Projects', text: 'Galvanised lattice towers, structural steel and walkways for infrastructure projects.', uses: [['Steel Structures', 'steel-structures'], ['Gratings', 'gratings']] },
  { img: 'power-transmission', title: 'Power Transmission and Distribution', text: 'Manufacturing Structural Steel and Tower solutions for HT, LT Overhead Transmission Lines, Substations and Switchyard Structures of up to 120 kV.', uses: [['Steel Structures', 'steel-structures'], ['Earthing Material', 'earthing-hardware']] },
  { img: 'renewable-bess', title: 'Renewable Energy & BESS', text: 'Providing Module mounting structures, walkways, cable trays and earthing for various renewable energy projects for effective and timely execution of projects.', uses: [['Steel Structures', 'steel-structures'], ['Cable Trays', 'cable-trays'], ['Earthing Material', 'earthing-hardware']] },
  { img: 'transport', title: 'Transport Infrastructure', text: 'Providing Structural Steel, support systems and cable management solutions for bringing efficient and effective design into reality across Airport, Railways and Metro Infrastructure as well as Subway and Tunnel Systems.', uses: [['Steel Structures', 'steel-structures'], ['Cable Trays', 'cable-trays']] },
  { img: 'industrial', title: 'Industrial & Manufacturing Facilities', text: 'Providing customized fabricated steel products with diverse applications across structural steel, cable management and walkway systems providing exceptional durability against tough conditions.', uses: [['Cable Trays', 'cable-trays'], ['Raceway', 'raceway'], ['Gratings', 'gratings']] },
  { img: 'high-finish', title: 'High Finish & People Centric Environments', text: 'Supplying premium, cable management and structural steel solutions with custom finishes built to elevate aesthetic, human-focused spaces across diverse sectors including spaces like malls, hospitals, residential and office projects, and many more.', uses: [['Cable Trays', 'cable-trays'], ['Steel Structures', 'steel-structures'], ['Raceway', 'raceway']] },
];
---
<Layout title="Industries - Swastik Industries" current="industries">
<main><div class="page-hero"><img class="bg" src="/assets/f75.webp" alt=""><div class="wrap"><div class="crumbs"><a href="/">Home</a> / Industries &amp; Applications</div><h1>Engineered for the Industries That Power Progress</h1><p>From power and renewables to transport and manufacturing, our structural steel and cable management solutions are made to your drawings and specifications.</p></div></div>
<section class="ind-sec"><div class="wrap"><div class="ind-intro"><h2>Industries We Serve and Applications</h2><p>Our products are used in solar plants, substations, transmission lines, towers, rail corridors and industrial plants.</p></div><div class="ind-list">
{rows.map((r, i) => (
  <article class="ind-row">
    <div class="ind-head"><span class="ind-num">{String(i + 1).padStart(2, '0')}</span><h2 class="ind-title">{r.title}</h2></div>
    <div class="ind-body"><p>{r.text}</p><ul class="ind-uses">{r.uses.map((u) => (<li><a href={`/${u[1]}`}>{u[0]}</a></li>))}</ul></div>
    <div class="ind-img"><img src={`/assets/industries/${r.img}.svg`} alt={r.title} loading="lazy" /></div>
  </article>
))}
</div></div></section>
<section class="alt clients-sec"><div class="wrap"><div class="sec-head"><h2 class="h-xl">Our Clients</h2></div><div class="client-logos"><img src="/assets/clients/delhi-metro.webp" alt="Delhi Metro" width="85" height="97" loading="lazy"><img src="/assets/clients/igi-airport.webp" alt="Delhi Indira Gandhi International Airport" width="129" height="96" loading="lazy"><img src="/assets/clients/eta-engineering.webp" alt="ETA Engineering" width="94" height="59" loading="lazy"><img src="/assets/clients/lanco.webp" alt="Lanco" width="142" height="32" loading="lazy"><img src="/assets/clients/jakson.webp" alt="Jakson" width="140" height="35" loading="lazy"><img src="/assets/clients/amplus-solar.webp" alt="Amplus Solar" width="95" height="62" loading="lazy"><img src="/assets/clients/larsen-toubro.webp" alt="Larsen &amp; Toubro" width="97" height="97" loading="lazy"></div></div></section><section class="cta-band"><div class="wrap"><h2>Share Your Requirements with Us</h2><a class="btn" href="/contact">Request a Quote</a></div></section></main>
</Layout>
