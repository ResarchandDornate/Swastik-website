<Layout title="Products - Swastik Industries" current="products">
<main><div class="page-hero"><img class="bg" src="/assets/f24.jpg" alt=""><div class="wrap"><div class="crumbs"><a href="/">Home</a> / Products</div><h1>Product range</h1><p>Cable trays, earthing material, structures and gratings. Standard sizes are held; special sizes and finishes are made to order.</p></div></div>
<section><div class="wrap"><div class="grid">
<a class="card" href="/cable-trays"><div class="ph"><img src="/assets/f24.jpg" alt="Cable tray run" loading="lazy"></div><div class="tx"><h3>Cable trays</h3><p>Perforated and ladder trays with bends, tees, reducers and crosses.</p><span class="more">View range</span></div></a><a class="card" href="/raceway"><div class="ph"><img src="/assets/f30.jpg" alt="Raceway bracket detail" loading="lazy"></div><div class="tx"><h3>Raceway</h3><p>C channel, strut channel, C1 channel, cantilever arms and junction boxes.</p><span class="more">View range</span></div></a><a class="card" href="/earthing-hardware"><div class="ph"><img src="/assets/f27.jpg" alt="Earthing material" loading="lazy"></div><div class="tx"><h3>Earthing</h3><p>GI and copper earthing material, foundation bolts, threaded rods, pipe clamps and U clamps.</p><span class="more">View range</span></div></a><a class="card" href="/steel-structures"><div class="ph"><img src="/assets/f33.jpg" alt="Steel structure" loading="lazy"></div><div class="tx"><h3>Structures</h3><p>Substation, transmission, solar, pipeline support and tower structures.</p><span class="more">View range</span></div></a><a class="card" href="/gratings"><div class="ph"><img src="/assets/f66.jpg" alt="Grating frame" loading="lazy"></div><div class="tx"><h3>Grating</h3><p>Bearing bar gratings and stair treads in sizes up to 2 m by 2 m.</p><span class="more">View range</span></div></a></div></div></section>
<section class="alt"><div class="wrap"><div class="sec-head"><h2>Range at a glance</h2></div><div class="tablewrap"><table class="sched">
<thead><tr><th>Family</th><th>Key specification</th><th>Finish options</th></tr></thead><tbody>
<tr><td>Perforated cable tray</td><td class="v">1.6 to 3.0 mm sheet; 2.5 / 3.0 m lengths</td><td>Pre-galvanised, hot dip galvanised, powder coated, painted</td></tr>
<tr><td>Ladder cable tray</td><td class="v">1.6 to 3.0 mm sheet; 2.5 / 3.0 m lengths</td><td>Pre-galvanised, hot dip galvanised, powder coated, painted</td></tr>
<tr><td>Raceway</td><td class="v">1.6 to 3.0 mm sheet; 2.5 / 3.0 m lengths</td><td>Pre-galvanised, hot dip galvanised, powder coated, painted</td></tr>
<tr><td>Earthing material</td><td class="v">IS 4759, IS 3043, IS 1239</td><td>GI and copper</td></tr>
<tr><td>Steel structures</td><td class="v">11, 33, 66 and 120 kV substations</td><td>Hot dip galvanised in-house</td></tr>
<tr><td>Gratings</td><td class="v">Bearing bar 30x5 to 50x6 mm; span and width up to 2 m</td><td>Made to order</td></tr>
</tbody></table></div></div></section><section class="cta-band"><div class="wrap"><h2>Send your drawing or bill of quantities</h2><a class="btn" href="/contact">Request a quote</a></div></section></main>
