---
import Layout from '../layouts/Layout.astro';
import { posts } from '../data/posts.js';
const fmt = (d) => new Date(d + 'T00:00:00').toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Layout title="Blog - Swastik Industries" current="blog">
<main><div class="page-hero"><img class="bg" src="/assets/f57.webp" alt=""><div class="wrap"><div class="crumbs"><a href="/">Home</a> / Blog</div><h1>Blog</h1><p>Short notes on choosing and specifying cable management, earthing and structures.</p></div></div><section><div class="wrap"><div class="blog-list">
{posts.map((p) => (
  <a class="blog-card" href={`/blog/${p.slug}`}>
    <div class="blog-ph"><img src={p.img} alt={p.alt} loading="lazy" /></div>
    <div class="blog-tx"><span class="blog-meta">{fmt(p.date)} &middot; {p.readMins} min read</span><h3>{p.title}</h3><p>{p.excerpt}</p><span class="more">Read Article</span></div>
  </a>
))}
</div></div></section><section class="cta-band"><div class="wrap"><h2>Share Your Requirements with Us</h2><a class="btn" href="/contact">Request a Quote</a></div></section></main>
</Layout>
