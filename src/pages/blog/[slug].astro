---
import Layout from '../../layouts/Layout.astro';
import { posts } from '../../data/posts.js';
const { slug } = Astro.params;
const post = posts.find((p) => p.slug === slug);
if (!post) return Astro.redirect('/blog');
const fmt = (d) => new Date(d + 'T00:00:00').toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
const others = posts.filter((p) => p.slug !== post.slug);
---
<Layout title={`${post.title} - Swastik Industries`} current="blog">
<main>
<div class="page-hero"><img class="bg" src={post.img} alt="" /><div class="wrap"><div class="crumbs"><a href="/">Home</a> / <a href="/blog">Blog</a></div><h1>{post.title}</h1><p>{fmt(post.date)} &middot; {post.readMins} min read</p></div></div>
<section><div class="wrap"><article class="post">
  <img class="post-img" src={post.img} alt={post.alt} />
  {post.body.map((b) => b.h ? <h2>{b.h}</h2> : b.p ? <p>{b.p}</p> : b.img ? <figure class="post-fig"><img src={b.img} alt={b.alt} loading="lazy" /><figcaption>{b.cap}</figcaption></figure> : <ul>{b.ul.map((li) => <li>{li}</li>)}</ul>)}
  <div class="post-end"><a class="btn" href="/contact">Request a Quote</a><a class="post-back" href="/blog">&larr; All Articles</a></div>
</article></div></section>
{others.length > 0 && (
<section class="alt"><div class="wrap"><div class="sec-head"><h2 class="h-xl">Read Next</h2></div><div class="blog-list">
  {others.map((o) => (<a class="blog-card" href={`/blog/${o.slug}`}><div class="blog-ph"><img src={o.img} alt={o.alt} loading="lazy" /></div><div class="blog-tx"><span class="blog-meta">{fmt(o.date)} &middot; {o.readMins} min read</span><h3>{o.title}</h3><span class="more">Read Article</span></div></a>))}
</div></div></section>
)}
<section class="cta-band"><div class="wrap"><h2>Share Your Requirements with Us</h2><a class="btn" href="/contact">Request a Quote</a></div></section>
</main>
</Layout>
